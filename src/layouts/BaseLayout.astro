---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Girish Lade — Software Engineer & Founder @ LadeStack",
  description = "Cinematic portfolio of Girish Lade — mechanical engineer transitioning into software engineering. Solo founder of LadeStack, building developer tools."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/hero/poster.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/hero/poster.jpg" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="bg-[#08090b] text-[#f8fafc] selection:bg-amber-500/30 selection:text-white min-h-screen">
    <!-- Anamorphic Top Letterbox Bar -->
    <header class="letterbox-bar letterbox-top" aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="rec-pulse"></span>
        <span class="tracking-widest font-semibold text-zinc-300">REC</span>
        <span class="text-zinc-600 hidden sm:inline">|</span>
        <span class="text-zinc-400 hidden sm:inline">4K 24FPS</span>
        <span class="text-zinc-600 hidden md:inline">|</span>
        <span class="text-zinc-500 hidden md:inline">PRORES 422 HQ</span>
      </div>
      <div class="text-zinc-500 tracking-widest hidden sm:block">
        LOG 01 // CINEMATIC REEL
      </div>
      <div class="flex items-center gap-3 text-zinc-400">
        <span class="hidden md:inline text-zinc-500">ASPECT</span>
        <span class="text-amber-400/90 font-mono font-medium">2.39:1</span>
      </div>
    </header>

    <!-- Shared Navigation Header Component -->
    <Header />

    <!-- Main Content Slot -->
    <main class="relative z-10 pt-[28px] pb-[28px]">
      <slot />
    </main>

    <!-- Anamorphic Bottom Letterbox Bar -->
    <footer class="letterbox-bar letterbox-bottom" aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="text-zinc-500">PUNE, IN</span>
        <span class="text-zinc-700">|</span>
        <span class="text-zinc-400">18.5204° N, 73.8567° E</span>
      </div>
      <div class="text-zinc-500 tracking-widest hidden sm:block">
        ENGINEERING CRAFT &bull; LADESTACK ARCHIVES
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-600">TIMECODE:</span>
        <span id="reel-timecode" class="text-amber-400/90 font-mono font-medium">00:00:00:00</span>
      </div>
    </footer>

    <!-- Global Client Scripts: Lenis Smooth Scroll + Timecode HUD -->
    <script>
      import Lenis from 'lenis';

      // Initialize Lenis Smooth Scroll if not reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      // Live Timecode HUD generator for cinematic immersion.
      // Perf: 4fps elapsed-time updates (was a 24fps setInterval counter) + skipped
      // entirely while the tab is hidden, so it never burns main-thread budget off-screen.
      const tcElement = document.getElementById('reel-timecode');
      if (tcElement) {
        const fps = 24;
        const bootTime = Date.now();
        const renderTimecode = () => {
          if (document.hidden) return;
          const elapsedFrames = Math.floor(((Date.now() - bootTime) / 1000) * fps);
          const frames = (elapsedFrames % fps).toString().padStart(2, '0');
          const totalSeconds = Math.floor(elapsedFrames / fps);
          const seconds = (totalSeconds % 60).toString().padStart(2, '0');
          const minutes = (Math.floor(totalSeconds / 60) % 60).toString().padStart(2, '0');
          const hours = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
          tcElement.textContent = `${hours}:${minutes}:${seconds}:${frames}`;
        };
        renderTimecode();
        setInterval(renderTimecode, 250);
      }
    </script>
  </body>
</html>
