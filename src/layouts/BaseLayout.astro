---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Girish Lade — Software Engineer & Founder @ LadeStack",
  description = "Cinematic portfolio of Girish Lade — mechanical engineer transitioning into software engineering. Solo founder of LadeStack, building developer tools."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/hero/poster.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/hero/poster.jpg" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="bg-[#08090b] text-[#f8fafc] selection:bg-amber-500/30 selection:text-white min-h-screen">
    <!-- Anamorphic Top Letterbox Bar -->
    <header class="letterbox-bar letterbox-top" aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="rec-pulse"></span>
        <span class="tracking-widest font-semibold text-zinc-300">REC</span>
        <span class="text-zinc-600 hidden sm:inline">|</span>
        <span class="text-zinc-400 hidden sm:inline">4K 24FPS</span>
        <span class="text-zinc-600 hidden md:inline">|</span>
        <span class="text-zinc-500 hidden md:inline">PRORES 422 HQ</span>
      </div>
      <div class="text-zinc-500 tracking-widest hidden sm:block">
        LOG 01 // CINEMATIC REEL
      </div>
      <div class="flex items-center gap-3 text-zinc-400">
        <span class="hidden md:inline text-zinc-500">ASPECT</span>
        <span class="text-amber-400/90 font-mono font-medium">2.39:1</span>
      </div>
    </header>

    <!-- Navigation Header -->
    <nav class="fixed top-[28px] left-0 right-0 z-50 px-6 py-4 transition-all duration-300 backdrop-blur-md bg-black/40 border-b border-white/[0.05]">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Monogram / Logo -->
        <a href="/" class="group flex items-center gap-3">
          <span class="w-8 h-8 rounded border border-white/20 bg-white/5 flex items-center justify-center font-heading font-bold text-sm tracking-wider text-white group-hover:border-amber-400/60 group-hover:text-amber-300 transition-colors">
            GL
          </span>
          <div class="flex flex-col">
            <span class="font-heading font-semibold text-sm tracking-widest text-zinc-100 group-hover:text-white transition-colors">
              GIRISH LADE
            </span>
            <span class="font-mono text-[10px] tracking-wider text-zinc-400">
              FOUNDER @ LADESTACK
            </span>
          </div>
        </a>

        <!-- Navigation Links -->
        <div class="hidden md:flex items-center gap-8 font-mono text-xs tracking-widest text-zinc-400">
          <a href="/work" class="hover:text-white transition-colors flex items-center gap-1.5">
            <span class="text-[10px] text-zinc-600">01</span>
            <span>WORK</span>
          </a>
          <a href="/about" class="hover:text-white transition-colors flex items-center gap-1.5">
            <span class="text-[10px] text-zinc-600">02</span>
            <span>ABOUT</span>
          </a>
          <a href="/stack" class="hover:text-white transition-colors flex items-center gap-1.5">
            <span class="text-[10px] text-zinc-600">03</span>
            <span>STACK</span>
          </a>
          <a href="#contact" class="hover:text-white transition-colors flex items-center gap-1.5">
            <span class="text-[10px] text-zinc-600">04</span>
            <span>CONTACT</span>
          </a>
        </div>

        <!-- Direct Social / Action Links -->
        <div class="flex items-center gap-3">
          <a 
            href="https://github.com/girishlade111" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 text-xs font-mono tracking-wider text-zinc-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 rounded transition-all flex items-center gap-1.5"
            aria-label="GitHub Profile"
          >
            <span>GITHUB</span>
            <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a 
            href="https://linkedin.com/in/girishlade" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 text-xs font-mono tracking-wider text-zinc-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 rounded transition-all flex items-center gap-1.5"
            aria-label="LinkedIn Profile"
          >
            <span>LINKEDIN</span>
            <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content Slot -->
    <main class="relative z-10 pt-[28px] pb-[28px]">
      <slot />
    </main>

    <!-- Anamorphic Bottom Letterbox Bar -->
    <footer class="letterbox-bar letterbox-bottom" aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="text-zinc-500">PUNE, IN</span>
        <span class="text-zinc-700">|</span>
        <span class="text-zinc-400">18.5204° N, 73.8567° E</span>
      </div>
      <div class="text-zinc-500 tracking-widest hidden sm:block">
        ENGINEERING CRAFT &bull; LADESTACK ARCHIVES
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-600">TIMECODE:</span>
        <span id="reel-timecode" class="text-amber-400/90 font-mono font-medium">00:00:00:00</span>
      </div>
    </footer>

    <!-- Global Client Scripts: Lenis Smooth Scroll + Timecode HUD -->
    <script>
      import Lenis from 'lenis';

      // Initialize Lenis Smooth Scroll if not reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      // Live Timecode HUD generator for cinematic immersion
      const tcElement = document.getElementById('reel-timecode');
      if (tcElement) {
        let frameCount = 0;
        setInterval(() => {
          frameCount++;
          const fps = 24;
          const frames = (frameCount % fps).toString().padStart(2, '0');
          const totalSeconds = Math.floor(frameCount / fps);
          const seconds = (totalSeconds % 60).toString().padStart(2, '0');
          const minutes = (Math.floor(totalSeconds / 60) % 60).toString().padStart(2, '0');
          const hours = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
          tcElement.textContent = `${hours}:${minutes}:${seconds}:${frames}`;
        }, 1000 / 24);
      }
    </script>
  </body>
</html>
