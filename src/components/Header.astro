---
// src/components/Header.astro - Global Shared Cinematic Navigation Header
interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;

import { withBase } from '../utils/site';

// Determine current active page from Astro.url (strip the deploy subpath first)
const pathname = Astro.url.pathname;
const baseStripped = pathname.replace(new RegExp(`^${import.meta.env.BASE_URL.replace(/\/$/, '')}`), '');
const normalizedPath = baseStripped.replace(/\/$/, '') || '/';

const navItems = [
  {
    label: 'WORK',
    href: withBase('/work'),
    index: '01',
    isActive: normalizedPath === '/work' || normalizedPath.startsWith('/work/'),
  },
  {
    label: 'ABOUT',
    href: withBase('/about'),
    index: '02',
    isActive: normalizedPath === '/about' || normalizedPath.startsWith('/about/'),
  },
  {
    label: 'STACK',
    href: withBase('/stack'),
    index: '03',
    isActive: normalizedPath === '/stack' || normalizedPath.startsWith('/stack/'),
  },
  {
    label: 'CONTACT',
    href: withBase('/contact'),
    index: '04',
    isActive: normalizedPath === '/contact' || normalizedPath.startsWith('/contact/'),
  },
];
---

<header class:list={['site-header fixed top-[28px] left-0 right-0 z-50 transition-all duration-300 backdrop-blur-md bg-black/60 border-b border-white/[0.08]', customClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
    
    <!-- Monogram / Logo -->
    <a href={withBase('/')} class="group flex items-center gap-3 select-none" aria-label="Girish Lade — Home">
      <span class="w-8 h-8 rounded border border-white/20 bg-white/5 flex items-center justify-center font-heading font-bold text-sm tracking-wider text-white group-hover:border-amber-400/60 group-hover:text-amber-300 transition-all shadow-sm">
        GL
      </span>
      <div class="flex flex-col">
        <span class="font-heading font-semibold text-xs sm:text-sm tracking-widest text-zinc-100 group-hover:text-white transition-colors">
          GIRISH LADE
        </span>
        <span class="font-mono text-[9px] sm:text-[10px] tracking-wider text-zinc-400">
          FOUNDER @ LADESTACK
        </span>
      </div>
    </a>

    <!-- Primary Navigation Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 font-mono text-xs tracking-widest" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class:list={[
            'relative py-1.5 flex items-center gap-1.5 transition-all duration-300 group',
            item.isActive 
              ? 'text-white font-semibold' 
              : 'text-zinc-400 hover:text-white'
          ]}
          aria-current={item.isActive ? 'page' : undefined}
        >
          <span class:list={[
            'text-[10px] transition-colors',
            item.isActive ? 'text-amber-400 font-bold' : 'text-zinc-600 group-hover:text-zinc-400'
          ]}>
            {item.index}
          </span>
          <span>{item.label}</span>
          
          <!-- Active Page Cinematic Indicator Underline -->
          {item.isActive && (
            <span 
              class="active-indicator absolute -bottom-[1px] left-0 right-0 h-[2px] bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 rounded-full shadow-[0_0_8px_rgba(245,158,11,0.7)]"
              aria-hidden="true"
            />
          )}
        </a>
      ))}
    </nav>

    <!-- Direct External Social / Repo Links -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a 
        href="https://github.com/girishlade111" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-mono tracking-wider text-zinc-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-amber-400/40 rounded transition-all flex items-center gap-1.5 group"
        aria-label="GitHub Profile"
      >
        <span>GITHUB</span>
        <svg class="w-3 h-3 text-zinc-400 group-hover:text-amber-400 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <a 
        href="https://linkedin.com/in/girishlade" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-mono tracking-wider text-zinc-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-amber-400/40 rounded transition-all flex items-center gap-1.5 group hidden xs:flex"
        aria-label="LinkedIn Profile"
      >
        <span>LINKEDIN</span>
        <svg class="w-3 h-3 text-zinc-400 group-hover:text-amber-400 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

  </div>

  <!-- Mobile Navigation Bar Strip -->
  <div class="md:hidden flex items-center justify-around px-2 py-2 border-t border-white/[0.05] bg-black/40 font-mono text-[11px] tracking-wider text-zinc-400 overflow-x-auto">
    {navItems.map((item) => (
      <a 
        href={item.href}
        class:list={[
          'px-2.5 py-1 rounded transition-colors flex items-center gap-1 shrink-0',
          item.isActive 
            ? 'text-amber-300 bg-amber-400/10 border border-amber-400/30 font-semibold' 
            : 'hover:text-white'
        ]}
        aria-current={item.isActive ? 'page' : undefined}
      >
        <span class={item.isActive ? 'text-amber-400' : 'text-zinc-600'}>{item.index}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</header>
