---
// CinematicOverlay.astro
// Reusable cinematic visual identity component:
// 1. GPU-cheap animated film grain (sub-50kb lightweight monochromatic SVG noise, 0 network requests)
// 2. Anamorphic edge vignette (radial gradient framing)
// 3. Drifting amber/orange light leaks & film burn (corner-positioned, screen blend mode, low opacity)

interface Props {
  intensity?: 'light' | 'heavy';
  position?: 'absolute' | 'fixed';
  showGrain?: boolean;
  showVignette?: boolean;
  showLightLeaks?: boolean;
  class?: string;
}

const {
  intensity = 'heavy',
  position = 'absolute',
  showGrain = true,
  showVignette = true,
  showLightLeaks = true,
  class: customClass = '',
} = Astro.props;

const isHeavy = intensity === 'heavy';
---

<div 
  class:list={[
    position === 'fixed' ? 'fixed' : 'absolute',
    'inset-0 w-full h-full pointer-events-none select-none overflow-hidden z-10',
    customClass
  ]}
  aria-hidden="true"
  data-cinematic-overlay
  data-intensity={intensity}
>
  {/* Layer 1: Drifting Amber / Orange Light Leaks & Film Burn (Edges & Corners) */}
  {showLightLeaks && (
    <div class:list={['cinematic-leaks-layer', isHeavy ? 'intensity-heavy' : 'intensity-light']}>
      <!-- Top-Left Warm Amber Corner Flare -->
      <div class="cinematic-leak leak-amber-corner"></div>
      <!-- Bottom-Right Golden Burn Flare -->
      <div class="cinematic-leak leak-orange-corner"></div>
      <!-- Top-Right Edge Accent Flare -->
      <div class="cinematic-leak leak-amber-edge"></div>
    </div>
  )}

  {/* Layer 2: Anamorphic Edge Vignette */}
  {showVignette && (
    <div class:list={['cinematic-vignette-layer', isHeavy ? 'intensity-heavy' : 'intensity-light']}></div>
  )}

  {/* Layer 3: GPU-cheap Monochromatic Animated Film Grain */}
  {showGrain && (
    <div class:list={['cinematic-grain-layer', isHeavy ? 'intensity-heavy' : 'intensity-light']}></div>
  )}
</div>

<style>
  /* Base Container: Absolute/Fixed, Non-blocking, hardware-accelerated */
  [data-cinematic-overlay] {
    contain: strict;
    pointer-events: none !important;
  }

  /* Layer 1: Drifting Light Leaks */
  .cinematic-leaks-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: screen;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .cinematic-leaks-layer.intensity-heavy {
    opacity: 0.60;
  }

  .cinematic-leaks-layer.intensity-light {
    opacity: 0.28;
  }

  .cinematic-leak {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
    transform: translateZ(0);
    will-change: transform, opacity;
  }

  /* Leak 1: Top-Left Corner Warm Amber Flare */
  .leak-amber-corner {
    top: -15%;
    left: -12%;
    width: 45vw;
    height: 45vw;
    max-width: 550px;
    max-height: 550px;
    background: radial-gradient(
      circle at 35% 35%,
      rgba(245, 158, 11, 0.32) 0%,
      rgba(217, 119, 6, 0.16) 40%,
      rgba(180, 83, 9, 0.05) 60%,
      transparent 75%
    );
    animation: leak-drift-amber 24s ease-in-out infinite alternate;
  }

  /* Leak 2: Bottom-Right Golden Orange Burn Flare */
  .leak-orange-corner {
    bottom: -15%;
    right: -10%;
    width: 42vw;
    height: 42vw;
    max-width: 520px;
    max-height: 520px;
    background: radial-gradient(
      circle at 65% 65%,
      rgba(234, 88, 12, 0.28) 0%,
      rgba(251, 191, 36, 0.14) 40%,
      rgba(245, 158, 11, 0.04) 65%,
      transparent 75%
    );
    animation: leak-drift-orange 28s ease-in-out infinite alternate-reverse;
  }

  /* Leak 3: Top-Right Edge Ambient Glow */
  .leak-amber-edge {
    top: -10%;
    right: -8%;
    width: 35vw;
    height: 35vw;
    max-width: 420px;
    max-height: 420px;
    background: radial-gradient(
      circle at 60% 40%,
      rgba(251, 191, 36, 0.22) 0%,
      rgba(217, 119, 6, 0.10) 45%,
      transparent 70%
    );
    animation: leak-drift-edge 20s ease-in-out infinite alternate;
  }

  /* Slow Ambient Drift Animations */
  @keyframes leak-drift-amber {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.75;
    }
    50% {
      transform: translate3d(4vw, 5vh, 0) scale(1.08);
      opacity: 1;
    }
    100% {
      transform: translate3d(1vw, 8vh, 0) scale(0.96);
      opacity: 0.7;
    }
  }

  @keyframes leak-drift-orange {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translate3d(-5vw, -4vh, 0) scale(1.10);
      opacity: 1;
    }
    100% {
      transform: translate3d(-2vw, -7vh, 0) scale(0.94);
      opacity: 0.65;
    }
  }

  @keyframes leak-drift-edge {
    0% {
      transform: translate3d(0, 0, 0) scale(0.95);
      opacity: 0.5;
    }
    50% {
      transform: translate3d(-3vw, 4vh, 0) scale(1.12);
      opacity: 0.85;
    }
    100% {
      transform: translate3d(2vw, -3vh, 0) scale(1.02);
      opacity: 0.6;
    }
  }

  /* Layer 2: Anamorphic Edge Vignette */
  .cinematic-vignette-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      transparent 45%,
      rgba(8, 9, 11, 0.35) 75%,
      rgba(4, 5, 7, 0.82) 100%
    );
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .cinematic-vignette-layer.intensity-heavy {
    opacity: 0.85;
  }

  .cinematic-vignette-layer.intensity-light {
    opacity: 0.45;
  }

  /* Layer 3: GPU-cheap Monochromatic Animated Film Grain */
  /* Perf: 130% overscan (was 200%) — still covers the ±2% jitter travel with margin,
     but blends ~2.4x fewer pixels per frame under mix-blend-mode: overlay. */
  .cinematic-grain-layer {
    position: absolute;
    top: -15%;
    left: -15%;
    width: 130%;
    height: 130%;
    /* Monochromatic fractal noise texture with desaturation matrix */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.07'/%3E%3C/svg%3E");
    background-repeat: repeat;
    mix-blend-mode: overlay;
    pointer-events: none;
    animation: grain-jitter 0.75s steps(4) infinite;
    will-change: transform;
    transition: opacity 0.5s ease;
  }

  .cinematic-grain-layer.intensity-heavy {
    opacity: 0.50;
  }

  .cinematic-grain-layer.intensity-light {
    opacity: 0.25;
  }

  @keyframes grain-jitter {
    0% {
      transform: translate3d(0, 0, 0);
    }
    25% {
      transform: translate3d(-1.5%, -2%, 0);
    }
    50% {
      transform: translate3d(2%, 1%, 0);
    }
    75% {
      transform: translate3d(-1%, 1.5%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Paused state (toggled by the observer script below when the overlay is
     off-screen or the tab is hidden) — freezes compositing work to zero while
     keeping every layer mounted, so visuals resume instantly with no reflow. */
  .cinematic-paused .cinematic-leak,
  .cinematic-paused .cinematic-grain-layer {
    animation-play-state: paused !important;
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .cinematic-leak {
      animation: none !important;
    }
    .cinematic-grain-layer {
      animation: none !important;
    }
  }
</style>

<script>
  // Perf: pause the grain + light-leak compositing work whenever ALL overlay
  // instances are off-screen (absolute-positioned, scrolled past) or the tab is
  // hidden. Layers stay mounted — visuals resume instantly, zero reflow, zero
  // feature loss. Fixed-position overlays are always intersecting, so they only
  // pause on tab-hide (correct: they are always visible otherwise).
  const overlays = document.querySelectorAll('[data-cinematic-overlay]');

  function refreshOverlayPause() {
    const shouldPause =
      document.hidden ||
      (overlays.length > 0 &&
        Array.from(overlays).every((el) => {
          const rect = el.getBoundingClientRect();
          return (
            rect.bottom <= 0 ||
            rect.top >= window.innerHeight ||
            rect.right <= 0 ||
            rect.left >= window.innerWidth
          );
        }));
    overlays.forEach((el) => el.classList.toggle('cinematic-paused', shouldPause));
  }

  let refreshQueued = false;
  function queueRefresh() {
    if (refreshQueued) return;
    refreshQueued = true;
    requestAnimationFrame(() => {
      refreshQueued = false;
      refreshOverlayPause();
    });
  }

  document.addEventListener('visibilitychange', refreshOverlayPause);
  window.addEventListener('scroll', queueRefresh, { passive: true });
  window.addEventListener('resize', queueRefresh);
  refreshOverlayPause();
</script>
