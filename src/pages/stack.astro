<style>
  .skill-card {
    will-change: transform, opacity;
  }

  .ladestack-card {
    will-change: transform, box-shadow;
  }
</style>

<!-- Client Script: GSAP Stagger ScrollTrigger Animation with Lifecycle Cleanup -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let stackTriggers: ScrollTrigger[] = [];

  export function cleanupStackAnimations() {
    if (stackTriggers && stackTriggers.length > 0) {
      stackTriggers.forEach((trigger) => {
        try {
          trigger.kill();
        } catch (e) {
          console.warn('ScrollTrigger cleanup error:', e);
        }
      });
      stackTriggers = [];
    }
  }

  export function initStackAnimations() {
    cleanupStackAnimations();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const skillCategoryBlocks = document.querySelectorAll('.skill-category-block');
    const productCards = document.querySelectorAll('.ladestack-card');

    if (prefersReducedMotion) {
      gsap.set(['.skill-card', '.ladestack-card'], {
        opacity: 1,
        y: 0,
        scale: 1,
      });
      return;
    }

    // 1. Stagger reveal skill cards per category as they enter viewport
    skillCategoryBlocks.forEach((block) => {
      const cards = block.querySelectorAll('.skill-card');
      if (cards.length === 0) return;

      const trigger = ScrollTrigger.create({
        trigger: block,
        start: 'top 85%',
        once: true,
        animation: gsap.fromTo(
          cards,
          { opacity: 0, y: 30, scale: 0.95 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.6,
            stagger: 0.06,
            ease: 'power2.out',
          }
        ),
      });
      stackTriggers.push(trigger);
    });

    // 2. Stagger reveal LadeStack product showcase cards
    if (productCards.length > 0) {
      const prodTrigger = ScrollTrigger.create({
        trigger: '.ladestack-card',
        start: 'top 85%',
        once: true,
        animation: gsap.fromTo(
          productCards,
          { opacity: 0, y: 35 },
          {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.12,
            ease: 'power2.out',
          }
        ),
      });
      stackTriggers.push(prodTrigger);
    }
  }

  // Execution hooks
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStackAnimations);
  } else {
    initStackAnimations();
  }

  document.addEventListener('astro:page-load', initStackAnimations);
  window.addEventListener('beforeunload', cleanupStackAnimations);
</script>
