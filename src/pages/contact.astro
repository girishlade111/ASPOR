---
// src/pages/contact.astro - Minimal Direct Contact & Closing Scene
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicOverlay from '../components/CinematicOverlay.astro';

const contactChannels = [
  {
    id: "email",
    label: "DIRECT DISPATCH",
    title: "GIRISHLADE111@GMAIL.COM",
    subtitle: "Direct email for high-impact software engineering roles & technical collaboration.",
    href: "mailto:girishlade111@gmail.com",
    badge: "PRIMARY INBOX",
    isPrimary: true,
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    id: "linkedin",
    label: "PROFESSIONAL PROFILE",
    title: "LINKEDIN / GIRISHLADE",
    subtitle: "Career trajectory, engineering endorsements, and verified industry background.",
    href: "https://linkedin.com/in/girishlade",
    badge: "NETWORK",
    isPrimary: false,
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>`
  },
  {
    id: "github",
    label: "SOURCE REPOSITORIES",
    title: "GITHUB / GIRISHLADE111",
    subtitle: "Public code archives, open-source utilities, and LadeStack project repositories.",
    href: "https://github.com/girishlade111",
    badge: "CODE REPOSITORIES",
    isPrimary: false,
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>`
  }
];
---

<BaseLayout 
  title="Contact & Direct Dispatch — Girish Lade | Founder @ LadeStack"
  description="Direct communication channels for Girish Lade. No lead-capture forms — direct email, LinkedIn, and GitHub links."
>
  <!-- Global Fixed Cinematic Visual Effects Overlay (Light intensity for calm closing atmosphere) -->
  <CinematicOverlay intensity="light" position="fixed" />

  <div class="contact-page-container relative w-full min-h-[calc(100vh-56px)] flex flex-col justify-between bg-[#08090b] text-[#f8fafc] px-4 sm:px-8 py-12 sm:py-16">
    
    <div class="max-w-4xl mx-auto w-full flex-1 flex flex-col justify-center">
      
      <!-- Top HUD Breadcrumb Strip -->
      <header class="mb-10 sm:mb-14 pt-4 text-center sm:text-left">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-white/10 bg-white/[0.04] backdrop-blur-md mb-4">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="font-mono text-xs tracking-widest text-zinc-300 uppercase">
            COMMUNICATION // DIRECT DISPATCH
          </span>
          <span class="text-zinc-600">|</span>
          <span class="font-mono text-xs tracking-wider text-amber-300 font-semibold">
            LOG 05
          </span>
        </div>

        <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl lg:text-6xl uppercase tracking-tight text-white leading-tight mb-4">
          DIRECT <span class="text-amber-400">DISPATCH.</span>
        </h1>

        <p class="font-sans font-light text-zinc-300 text-sm sm:text-base md:text-lg max-w-2xl leading-relaxed text-balance">
          Intentionally minimal. No lead-capture funnels, newsletter signups, or intermediaries. Reach out directly through verified personal channels.
        </p>
      </header>

      <!-- Three Direct Links Container (Large HUD Button Cards) -->
      <main class="space-y-4 sm:space-y-5 mb-14 sm:mb-18">
        {contactChannels.map((channel) => (
          <a 
            href={channel.href}
            target={channel.id === 'email' ? '_self' : '_blank'}
            rel={channel.id === 'email' ? undefined : 'noopener noreferrer'}
            class:list={[
              'group relative block w-full p-6 sm:p-7 rounded-2xl border transition-all duration-300 backdrop-blur-xl',
              channel.isPrimary 
                ? 'bg-[#0d0f14]/90 border-amber-500/30 hover:border-amber-400 hover:shadow-2xl hover:shadow-amber-400/10' 
                : 'bg-[#0d0f14]/75 border-white/10 hover:border-amber-400/50 hover:bg-[#0d0f14]/95 hover:shadow-xl hover:shadow-black/60'
            ]}
            aria-label={`${channel.label}: ${channel.title}`}
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <!-- Channel Info -->
              <div class="flex-1">
                <div class="flex items-center gap-2.5 font-mono text-[11px] tracking-wider mb-2">
                  <span class:list={[
                    'w-1.5 h-1.5 rounded-full',
                    channel.isPrimary ? 'bg-amber-400' : 'bg-zinc-400 group-hover:bg-amber-400 transition-colors'
                  ]}></span>
                  <span class="text-zinc-400 uppercase tracking-widest">{channel.label}</span>
                  <span class="text-zinc-600">|</span>
                  <span class="text-amber-300/90 font-medium">[{channel.badge}]</span>
                </div>

                <div class="font-heading font-bold text-lg sm:text-xl text-white group-hover:text-amber-300 transition-colors tracking-tight mb-1">
                  {channel.title}
                </div>

                <p class="font-sans font-light text-zinc-400 text-xs sm:text-sm">
                  {channel.subtitle}
                </p>
              </div>

              <!-- HUD Action Indicator -->
              <div class="flex items-center gap-3 self-start sm:self-center">
                <div class:list={[
                  'px-4 py-2 rounded-lg font-mono text-xs tracking-wider flex items-center gap-2 transition-all duration-300 border',
                  channel.isPrimary
                    ? 'bg-amber-400 text-zinc-950 font-semibold border-amber-300 group-hover:bg-amber-300'
                    : 'bg-white/[0.04] group-hover:bg-white/[0.08] text-zinc-300 group-hover:text-white border-white/10 group-hover:border-amber-400/40'
                ]}>
                  <span>{channel.id === 'email' ? 'SEND EMAIL' : 'OPEN LINK'}</span>
                  <div 
                    class="transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                    set:html={channel.icon}
                  />
                </div>
              </div>
            </div>
          </a>
        ))}
      </main>

      <!-- Closing Telemetry Metadata Box -->
      <div class="p-6 rounded-xl bg-black/40 border border-white/10 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold">[+]</span>
          <span>LOCATION: PUNE, INDIA (IST // UTC+5:30)</span>
          <span class="text-zinc-700 hidden md:inline">|</span>
          <span class="text-zinc-500 hidden md:inline">GLOBAL REMOTE FRIENDLY</span>
        </div>
        <div class="flex items-center gap-2 text-zinc-500 text-[11px]">
          <span>TARGET: HIGH-VELOCITY PRODUCT TEAMS</span>
        </div>
      </div>

    </div>

    <!-- Understated Closing HUD Device Line -->
    <footer class="max-w-4xl mx-auto w-full pt-12 pb-4 text-center select-none pointer-events-none">
      <div class="flex items-center justify-center gap-3 font-mono text-[10px] tracking-widest text-zinc-500 uppercase">
        <div class="w-12 h-[1px] bg-gradient-to-r from-transparent to-white/20"></div>
        <span>// END OF DOCUMENTARY REEL // SCENE 05 &bull; ARCHIVES COMPLETE //</span>
        <div class="w-12 h-[1px] bg-gradient-to-l from-transparent to-white/20"></div>
      </div>
    </footer>

  </div>
</BaseLayout>
